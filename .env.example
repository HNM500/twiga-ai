# Twiga AI local development. Never commit real credentials.

# Required MVP services
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-oss-20b
OPENROUTER_SEARCH_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_ROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_REASONING_MODEL=z-ai/glm-5.2
EXA_API_KEY=
TWIGA_CORE_URL=http://twiga-core:4000
TWIGA_CORE_ASSERTION_SECRET=replace-with-the-same-32-character-or-longer-secret-used-by-twiga-core
DATABASE_URL=postgresql://twiga:twiga_local_only@localhost:55432/twiga
REDIS_URL=redis://localhost:56379

# Authentication and public origins
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
AUTH_COOKIE_DOMAIN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Twiga Admin boundary
ADMIN_EMAIL_ALLOWLIST=
TWIGA_ADMIN_SERVICE_SECRET=

# Privacy-scrubbed Sentry SDK and read-only issue summaries
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public source for AGPL network-use compliance
NEXT_PUBLIC_SOURCE_URL=https://github.com/HNM500/twiga-ai
SOURCE_REVISION=local

# Deferred Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Permanent email/password sign-in. Keep verification false only while testing
# before Resend and a verified sending domain are configured.
AUTH_EMAIL_VERIFICATION_REQUIRED=false
NEXT_PUBLIC_AUTH_EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=Twiga <accounts@twiga.ai>

# Retained capabilities. Enable only after completing the readiness checks in
# SCIRA_FEATURE_AUDIT.md and configuring their server-side credentials.
NEXT_PUBLIC_MCP_ENABLED=false
MCP_CREDENTIALS_ENCRYPTION_KEY=
MCP_OAUTH_CALLBACK_ORIGIN=http://localhost:3000
NEXT_PUBLIC_YOUTUBE_ENABLED=false
SUPADATA_API_KEY=

# Deferred ingestion
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
